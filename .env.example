# Copy to .env.local and fill in. Values here are placeholders only.

# --- Sanity (client portals) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-11
SANITY_API_WRITE_TOKEN=
# Viewer role. Draft preview in Studio only.
SANITY_API_READ_TOKEN=
# Absolute origin this app is served from, e.g. https://portals.finalresearch.org.
# Falls back to VERCEL_URL, then http://localhost:3000. Required for Studio's
# Presentation tool to connect visual editing overlays (stega.studioUrl needs
# an absolute URL, not a relative path).
NEXT_PUBLIC_SITE_URL=

# --- Portal sessions ---
# openssl rand -base64 32
PORTAL_SESSION_SECRET=

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Mux (video walkthroughs) ---
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# --- Resend (first-open email) ---
RESEND_API_KEY=
PORTAL_NOTIFY_EMAIL=

# --- Invoices ---
# openssl rand -base64 32. Gates /api/invoices/*/pdf.
INVOICE_PREVIEW_SECRET=
